# Polymarket 配置
# 私钥 (不带0x前缀也可)
POLYMARKET_PRIVATE_KEY=your_private_key_here

# 代理钱包的funder地址 (如果使用email/Magic钱包)
# POLYMARKET_FUNDER_ADDRESS=0x...

# 签名类型: 0=EOA钱包, 1=代理钱包(email/Magic)
POLYMARKET_SIGNATURE_TYPE=0

# 市场配置 (逗号分隔)
# 格式: token_id:市场名称:到期天数
POLYMARKET_MARKETS=token_id_1:MarketName1:30,token_id_2:MarketName2:60
