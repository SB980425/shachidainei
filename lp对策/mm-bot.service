[Unit]
Description=Prediction Market MM Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mm-bot
Environment=MM_CONFIG_OVERRIDE_FILE=/home/ubuntu/mm-bot/config.account1.yaml
ExecStart=/home/ubuntu/mm-bot/venv/bin/python /home/ubuntu/mm-bot/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
